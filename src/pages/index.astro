---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPosts, url } from '../utils';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE}>
  <section class="hero">
    <h1>Architecture that ships.</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <h2>Latest posts</h2>
  <PostList posts={posts} />
  <p class="all"><a href={url('posts/')}>Browse all posts →</a></p>
</BaseLayout>

<style>
  .hero { padding-bottom: 1.5rem; }
  .hero h1 { font-size: clamp(2rem, 6vw, 2.8rem); letter-spacing: -0.03em; margin-bottom: 0.4em; }
  .hero p { font-size: 1.25rem; color: var(--muted); max-width: 34rem; }
  .all { font-family: var(--font-ui); font-size: 0.95rem; margin-top: 1.5rem; }
</style>
