---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../utils';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a class="title" href={url(`posts/${post.id}/`)}>{post.data.title}</a>
      <p>{post.data.description}</p>
    </li>
  ))}
</ul>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; }
  li { padding: 1.25rem 0; border-bottom: 1px solid var(--border); }
  li:first-child { padding-top: 0; }
  time { display: block; font-family: var(--font-ui); font-size: 0.8rem; color: var(--muted); }
  .title {
    font-family: var(--font-ui);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .title:hover { color: var(--accent); }
  p { margin: 0.3rem 0 0; color: var(--muted); }
</style>
